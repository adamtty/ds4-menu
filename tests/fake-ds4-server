#!/usr/bin/env python3
"""Stands in for ds4-server in tests: answers /v1/models and returns a canned chat reply."""
import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

port = int(sys.argv[sys.argv.index("--port") + 1])


class Handler(BaseHTTPRequestHandler):
    def reply(self, body):
        data = json.dumps(body).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.reply({"data": [{"id": "fake"}]})

    def do_POST(self):
        self.rfile.read(int(self.headers.get("Content-Length", 0)))
        self.reply({"choices": [{"message": {"role": "assistant", "content": "pong"}}]})

    def log_message(self, *a):
        pass


print("fake ds4-server args:", " ".join(sys.argv[1:]), flush=True)
HTTPServer(("127.0.0.1", port), Handler).serve_forever()
